---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';
import GitHubStar from './GitHubStar.astro';
import phenomWordmarkUrl from '../assets/phenom-wordmark.svg?url';
---

<footer class="sl-flex">
	<div class="meta sl-flex">
		<EditLink />
		<LastUpdated />
	</div>
	<Pagination />
	<div class="phenom-credit">
		<img src={phenomWordmarkUrl} alt="Phenom Studios" width="912" height="201" />
		<span>© 2026. All rights reserved.</span>
	</div>
<GitHubStar />
</footer>

<style>
	@layer starlight.core {
		footer {
			flex-direction: column;
			gap: 1.5rem;
		}

		.meta {
			gap: 0.75rem 3rem;
			justify-content: space-between;
			flex-wrap: wrap;
			margin-top: 3rem;
			font-size: var(--sl-text-sm);
			color: var(--sl-color-gray-3);
		}

		.meta > :global(p:only-child) {
			margin-inline-start: auto;
		}

		.phenom-credit {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: 0.875rem;
			width: 100%;
			padding-block: 0.75rem 0.25rem;
			color: var(--sl-color-gray-3);
			font-size: var(--sl-text-sm);
		}

		.phenom-credit img {
			display: block;
			width: auto;
			height: 1.75rem;
		}
	}
</style>
