---
---

<div class="gh-toast-stack" id="gh-toast-stack">
	<div class="gh-issue-toast" id="gh-issue-toast" aria-label="Page feedback" hidden>
		<button class="gh-toast-dismiss" id="gh-issue-dismiss" aria-label="Dismiss">&times;</button>
		<span class="gh-issue-label">Issue on this page?</span>
		<div class="gh-issue-links">
			<a class="gh-issue-link" id="gh-edit-link" href="#" target="_blank" rel="noopener">
				<svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
					<path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758l8.61-8.61Zm.176 4.823L9.75 4.81l-6.286 6.287a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.249.249 0 0 0 .108-.064l6.286-6.286Z" />
				</svg>
				Edit page
			</a>
			<span class="gh-issue-sep">·</span>
			<a class="gh-issue-link" id="gh-report-link" href="#" target="_blank" rel="noopener">
				<svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
					<path d="M8 9.5a1.5 1.5 0 1 0 0-3 1.5 1.5 0 0 0 0 3Z" />
					<path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0ZM1.5 8a6.5 6.5 0 1 0 13 0 6.5 6.5 0 0 0-13 0Z" />
				</svg>
				Report issue
			</a>
		</div>
	</div>

	<div class="gh-card" id="gh-card" aria-label="GitHub repository" hidden>
		<button class="gh-toast-dismiss" id="gh-card-dismiss" aria-label="Dismiss">&times;</button>
		<div class="gh-card-header">
			<svg class="gh-card-logo" viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
				<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
			</svg>
			<span class="gh-card-repo">RJPhenom/SeinARTS</span>
		</div>
		<div class="gh-card-stats">
			<div class="gh-card-stat">
				<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
					<path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
				</svg>
				<span class="gh-card-stat-val" id="gh-stars">—</span>
			</div>
			<div class="gh-card-stat">
				<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
					<path d="M5 5.372v.878c0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75v-.878a2.25 2.25 0 1 1 1.5 0v.878a2.25 2.25 0 0 1-2.25 2.25h-1.5v2.128a2.251 2.251 0 1 1-1.5 0V8.5h-1.5A2.25 2.25 0 0 1 3.5 6.25v-.878a2.25 2.25 0 1 1 1.5 0ZM5 3.25a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Zm6.75.75a.75.75 0 1 0 0-1.5.75.75 0 0 0 0 1.5Zm-3 8.75a.75.75 0 1 0-1.5 0 .75.75 0 0 0 1.5 0Z" />
				</svg>
				<span class="gh-card-stat-val" id="gh-forks">—</span>
			</div>
			<div class="gh-card-stat">
				<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
					<path d="M8 2c1.981 0 3.671.992 4.933 2.078 1.27 1.091 2.187 2.345 2.637 3.023a1.62 1.62 0 0 1 0 1.798c-.45.678-1.367 1.932-2.637 3.023C11.67 13.008 9.981 14 8 14c-1.981 0-3.671-.992-4.933-2.078C1.797 10.83.88 9.576.43 8.898a1.62 1.62 0 0 1 0-1.798c.45-.677 1.367-1.931 2.637-3.022C4.33 2.992 6.019 2 8 2ZM1.679 7.932a.12.12 0 0 0 0 .136c.411.622 1.241 1.75 2.366 2.717C5.176 11.758 6.527 12.5 8 12.5c1.473 0 2.825-.742 3.955-1.715 1.124-.967 1.954-2.096 2.366-2.717a.12.12 0 0 0 0-.136c-.412-.621-1.242-1.75-2.366-2.717C10.824 4.242 9.473 3.5 8 3.5c-1.473 0-2.824.742-3.955 1.715-1.124.967-1.954 2.096-2.366 2.717ZM8 10a2 2 0 1 1-.001-3.999A2 2 0 0 1 8 10Z" />
				</svg>
				<span class="gh-card-stat-val" id="gh-watchers">—</span>
			</div>
		</div>
		<a class="gh-card-btn" href="https://github.com/RJPhenom/SeinARTS" target="_blank" rel="noopener">
			<svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor" aria-hidden="true">
				<path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z" />
			</svg>
			Star on GitHub
		</a>
	</div>
</div>

<script>
	const STAR_DISMISS_KEY = 'seinarts-gh-star-dismissed';
	const ISSUE_DISMISS_KEY = 'seinarts-gh-issue-dismissed';
	const CACHE_KEY = 'seinarts-gh-stats';
	const CACHE_TTL = 3600000;
	const REPO = 'RJPhenom/SeinARTS';
	const BRANCH = 'main';
	const DOCS_ROOT = 'Docs/src/content/docs';

	function slugToFilePath(pathname) {
		const slug = pathname.replace(/^\/|\/$/g, '');
		if (!slug) return null;
		return DOCS_ROOT + '/' + slug + '.mdx';
	}

	function buildEditUrl(pathname) {
		const file = slugToFilePath(pathname);
		if (!file) return null;
		return 'https://github.com/' + REPO + '/edit/' + BRANCH + '/' + file;
	}

	function buildIssueUrl(pathname) {
		const title = encodeURIComponent('Docs: ' + pathname);
		const body = encodeURIComponent('**Page:** ' + window.location.href + '\n\n**Issue:**\n');
		return 'https://github.com/' + REPO + '/issues/new?title=' + title + '&body=' + body + '&labels=documentation';
	}

	async function fetchStats() {
		const cached = localStorage.getItem(CACHE_KEY);
		if (cached) {
			try {
				const parsed = JSON.parse(cached);
				if (Date.now() - parsed.ts < CACHE_TTL) return parsed;
			} catch {}
		}
		try {
			const res = await fetch('https://api.github.com/repos/' + REPO);
			if (!res.ok) return null;
			const data = await res.json();
			const stats = {
				stars: data.stargazers_count,
				forks: data.forks_count,
				watchers: data.subscribers_count,
				ts: Date.now(),
			};
			localStorage.setItem(CACHE_KEY, JSON.stringify(stats));
			return stats;
		} catch {
			return null;
		}
	}

	function formatNum(n) {
		if (n == null) return '—';
		if (n >= 1000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
		return String(n);
	}

	function setupDismiss(toastEl, btnEl, storageKey) {
		btnEl.addEventListener('click', () => {
			toastEl.classList.remove('gh-toast-visible');
			toastEl.classList.add('gh-toast-hiding');
			toastEl.addEventListener('animationend', () => {
				toastEl.hidden = true;
			}, { once: true });
			localStorage.setItem(storageKey, '1');
		});
	}

	async function initToasts() {
		const card = document.getElementById('gh-card');
		const cardDismiss = document.getElementById('gh-card-dismiss');
		const issueToast = document.getElementById('gh-issue-toast');
		const issueDismiss = document.getElementById('gh-issue-dismiss');
		const editLink = document.getElementById('gh-edit-link');
		const reportLink = document.getElementById('gh-report-link');
		if (!card || !cardDismiss) return;

		const isContentPage = !!document.querySelector('.right-sidebar-container');
		const starDismissed = localStorage.getItem(STAR_DISMISS_KEY);
		const issueDismissed = localStorage.getItem(ISSUE_DISMISS_KEY);

		if (isContentPage && !issueDismissed && issueToast && issueDismiss && editLink && reportLink) {
			const pathname = window.location.pathname;
			const editUrl = buildEditUrl(pathname);
			const issueUrl = buildIssueUrl(pathname);
			if (editUrl) editLink.href = editUrl;
			reportLink.href = issueUrl;

			setupDismiss(issueToast, issueDismiss, ISSUE_DISMISS_KEY);
			setTimeout(() => {
				issueToast.hidden = false;
				issueToast.classList.add('gh-toast-visible');
			}, 500);
		}

		if (!starDismissed) {
			const stats = await fetchStats();
			if (stats) {
				const starsEl = document.getElementById('gh-stars');
				const forksEl = document.getElementById('gh-forks');
				const watchersEl = document.getElementById('gh-watchers');
				if (starsEl) starsEl.textContent = formatNum(stats.stars);
				if (forksEl) forksEl.textContent = formatNum(stats.forks);
				if (watchersEl) watchersEl.textContent = formatNum(stats.watchers);
			}

			setupDismiss(card, cardDismiss, STAR_DISMISS_KEY);
			setTimeout(() => {
				card.hidden = false;
				card.classList.add('gh-toast-visible');
			}, 500);
		}
	}

	initToasts();
	document.addEventListener('astro:after-swap', initToasts);
</script>

<style>
	.gh-toast-stack {
		position: fixed;
		z-index: 5;
		bottom: 1.5rem;
		right: 1.5rem;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.5rem;
	}

	.gh-issue-toast,
	.gh-card {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.375rem;
		width: 15rem;
		padding: 0.75rem 1rem;
		border: 1px solid #30363d;
		border-radius: 0.5rem !important;
		background: #0d1117;
		color: #e6edf3;
		font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Noto Sans', Helvetica, Arial, sans-serif;
		font-size: 0.8125rem;
		opacity: 0;
		transform: translateY(0.5rem);
		pointer-events: none;
	}

	.gh-card {
		gap: 0.625rem;
		padding: 0.875rem 1rem;
	}

	.gh-issue-toast.gh-toast-visible,
	.gh-card.gh-toast-visible {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
		animation: gh-toast-in 400ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}

	.gh-issue-toast.gh-toast-hiding,
	.gh-card.gh-toast-hiding {
		animation: gh-toast-out 250ms ease forwards;
		pointer-events: none;
	}

	@keyframes gh-toast-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem) scale(0.95);
		}
		to {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	@keyframes gh-toast-out {
		from {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
		to {
			opacity: 0;
			transform: translateY(0.25rem) scale(0.95);
		}
	}

	.gh-toast-dismiss {
		position: absolute;
		top: 0.375rem;
		right: 0.375rem;
		display: grid;
		place-items: center;
		width: 1.25rem;
		height: 1.25rem;
		padding: 0;
		border: none;
		border-radius: 0.25rem;
		background: transparent;
		color: #484f58;
		font-size: 1rem;
		line-height: 1;
		cursor: pointer;
		transition: color 160ms ease;
	}

	.gh-toast-dismiss:hover {
		color: #e6edf3;
	}

	/* Issue toast */
	.gh-issue-label {
		font-size: 0.75rem;
		font-weight: 600;
		color: #8b949e;
	}

	.gh-issue-links {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.gh-issue-link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		color: #58a6ff;
		font-size: 0.75rem;
		font-weight: 500;
		text-decoration: none;
	}

	.gh-issue-link:hover {
		text-decoration: underline;
	}

	.gh-issue-link svg {
		flex: none;
		color: #8b949e;
	}

	.gh-issue-sep {
		color: #30363d;
		font-size: 0.75rem;
	}

	/* Star card */
	.gh-card-header {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.gh-card-logo {
		flex: none;
		color: #e6edf3;
	}

	.gh-card-repo {
		font-size: 0.8125rem;
		font-weight: 600;
		color: #58a6ff;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.gh-card-stats {
		display: flex;
		gap: 1rem;
		padding-block: 0.125rem;
	}

	.gh-card-stat {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		color: #8b949e;
	}

	.gh-card-stat svg {
		flex: none;
	}

	.gh-card-stat-val {
		font-size: 0.75rem;
		font-weight: 500;
		font-variant-numeric: tabular-nums;
	}

	.gh-card-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.375rem;
		padding: 0.3125rem 0.75rem;
		border: 1px solid #30363d;
		border-radius: 0.375rem;
		background: #21262d;
		color: #e6edf3;
		font-size: 0.75rem;
		font-weight: 500;
		text-decoration: none;
		cursor: pointer;
		transition: background 160ms ease, border-color 160ms ease;
	}

	.gh-card-btn:hover {
		background: #30363d;
		border-color: #8b949e;
		text-decoration: none;
	}

	.gh-card-btn svg {
		flex: none;
		color: #e3b341;
	}

	@media (min-width: 72rem) {
		:global(body:has(.right-sidebar-container)) .gh-toast-stack {
			right: calc(var(--sl-sidebar-width) + 1.5rem);
		}
	}
</style>
