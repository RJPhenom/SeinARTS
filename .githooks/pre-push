#!/bin/sh
# SeinARTS push-to-main automation: whenever main is pushed, launch the
# WARSEIN sync (package FAB-style -> install -> commit/push WARSEIN -> build)
# detached, so the push returns immediately and the sync runs in background.
#
# Enable once per clone:   git config core.hooksPath .githooks
# Logs land in:            ../WARSEIN/Saved/SeinSync/sync-<stamp>.log
# The sync script is Scripts/SyncWARSEIN.ps1; run it manually for a
# foreground sync or after fixing a failed one.
#
# This hook REPLACES git-lfs's default pre-push hook (core.hooksPath wins), so
# it must run `git lfs pre-push` itself or LFS objects never upload and GitHub
# rejects the push with "unknown Git LFS objects" (bitten 2026-08-23). The ref
# list arrives on stdin exactly once: capture it, hand it to LFS, then reuse it.

refs=$(cat)

if command -v git-lfs >/dev/null 2>&1; then
	printf '%s\n' "$refs" | git lfs pre-push "$@" || exit $?
else
	printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path."
	exit 2
fi

printf '%s\n' "$refs" | while read local_ref local_sha remote_ref remote_sha; do
	if [ "$remote_ref" = "refs/heads/main" ]; then
		powershell.exe -NoProfile -Command "
			\$repo = (Get-Location).Path;
			\$sync = Join-Path \$repo 'Scripts\SyncWARSEIN.ps1';
			\$logDir = Join-Path (Split-Path -Parent \$repo) 'WARSEIN\Saved\SeinSync';
			New-Item -ItemType Directory -Force -Path \$logDir | Out-Null;
			\$stamp = Get-Date -Format 'yyyyMMdd-HHmmss';
			Start-Process pwsh -WindowStyle Hidden \
				-ArgumentList '-NoProfile','-File',('\"{0}\"' -f \$sync) \
				-RedirectStandardOutput (Join-Path \$logDir \"sync-\$stamp.log\") \
				-RedirectStandardError  (Join-Path \$logDir \"sync-\$stamp.err.log\")
		" >/dev/null 2>&1
		echo "pre-push: WARSEIN sync launched (log: ../WARSEIN/Saved/SeinSync/)" >&2
		break
	fi
done
exit 0
