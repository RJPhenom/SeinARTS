# ──────────────────────────────────────────────────────────────────────────────
# SeinARTS — project-wide .gitattributes
# Normalize text line endings; route Unreal binary assets through Git LFS.
# This file MUST be staged before the binary assets so LFS catches them on the
# first commit. It lives only at the repo root — do not add nested .gitattributes
# under Plugins/, or they would override these LFS filters for that subtree.
# ──────────────────────────────────────────────────────────────────────────────

# Auto-detect text vs binary; normalize text to LF in the repo, native on checkout.
* text=auto

# ── Git LFS: Unreal native assets ──
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text

# ── Git LFS: common binary source media that lands in Content/ ──
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.bmp     filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.mp3     filter=lfs diff=lfs merge=lfs -text
*.ogg     filter=lfs diff=lfs merge=lfs -text
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text

# ── Keep source/config explicitly diffable as text ──
*.cpp      text
*.h        text
*.cs       text diff=csharp
*.ini      text
*.uproject text
*.uplugin  text
*.ps1      text
*.md       text
